# ==============================================================================
# METRIXA Backend - Production & Development Environment Configuration
# ==============================================================================

PROJECT_NAME="METRIXA"
PROJECT_DESCRIPTION="Legal Metrology Inspection Platform"
LEGAL_FRAMEWORK="Legal Metrology Act, 2009 & Legal Metrology (Packaged Commodities) Rules, 2011"
API_V1_STR="/api/v1"

# Environment: "development" or "production"
# (In production, DEBUG must be false and JWT_SECRET_KEY must be a secure random 32+ char string)
ENVIRONMENT="production"
DEBUG=false

# ------------------------------------------------------------------------------
# Database Configuration (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase direct connection or transaction pooler (port 6543 / 5432):
# Metrixa auto-normalizes postgres:// or postgresql:// to postgresql+asyncpg://
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-DATABASE-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# For local development with Docker Compose:
# DATABASE_URL="postgresql+asyncpg://metrixa:metrixa_secret_dev_2026@localhost:5432/metrixa_db"

DB_ECHO=false

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="generate-a-strong-random-secret-key-at-least-32-chars-long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Storage Abstraction (Evidence, Surface Images, PDF Dossiers)
# ------------------------------------------------------------------------------
# Storage backend: "local" (default filesystem/volume mount)
STORAGE_BACKEND="local"
# For Linux Docker / Railway deployment with persistent volume mounted at /app/storage:
STORAGE_ROOT="/app/storage"
# For local Windows development:
# STORAGE_ROOT="storage"

# ------------------------------------------------------------------------------
# OCR Configuration
# ------------------------------------------------------------------------------
# In Linux Docker container, Tesseract is auto-detected at /usr/bin/tesseract via PATH.
# In custom environments, specify the explicit binary path:
# TESSERACT_CMD="/usr/bin/tesseract"

# ------------------------------------------------------------------------------
# Server & Networking (Railway / Container)
# ------------------------------------------------------------------------------
# Port is automatically assigned by Railway via PORT env var at runtime.
PORT=8080
HOST="0.0.0.0"

# CORS Allowed Origins: comma-separated or JSON array.
# Include your Vercel production frontend domain and local preview domains.
# NOTE: Do NOT use '*' wildcard in production when credentials are enabled.
CORS_ORIGINS="https://<your-metrixa-frontend>.vercel.app,http://localhost:5173"
