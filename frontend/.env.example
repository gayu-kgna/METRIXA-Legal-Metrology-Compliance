# ==============================================================================
# METRIXA Frontend - Production & Staging Environment Variables
# ==============================================================================

# API Base URL pointing to the deployed FastAPI backend.
# In local development: leave blank or set to /api/v1 to use Vite's built-in proxy (target: http://localhost:8080)
# In production (e.g. Vercel): set to your Railway backend URL + /api/v1
# Example: https://metrixa-backend.up.railway.app/api/v1
VITE_API_BASE_URL=https://<your-backend-app>.up.railway.app/api/v1
